# Railway Staging template. Set every value in Railway's private variables UI.
# Do not put real credentials in this file.
APP_ENV=production
PORT=$PORT
DATABASE_URL=postgresql://<railway-user>:<railway-password>@<railway-host>/<railway-database>
REDIS_URL=redis://<redis-host>:6379
CACHE_INDEX_NAME=cache_idx
BYOK_ENABLED=true
ALLOW_GLOBAL_PROVIDER_FALLBACK=false
AUTH_SECRET_KEY=<generate-a-new-production-secret>
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=<generate-a-fernet-key>
CORS_ALLOWED_ORIGINS=https://<staging-domain>
AUTH_FRONTEND_URL=https://<staging-domain>
GITHUB_OAUTH_CLIENT_ID=<github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<github-oauth-client-secret>
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
# SMTP/Resend are not used for authentication. Keep notification settings only
# if a future non-auth notification feature explicitly needs them.
SMTP_TIMEOUT_SECONDS=10
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=<smtp-from-email>
SMTP_USE_TLS=true
# Use EMAIL_PROVIDER=resend in Railway if SMTP egress is blocked.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=<verified-resend-sender>
IMAGE_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<s3-compatible-endpoint>
S3_BUCKET=<private-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=<private-storage-access-key>
S3_SECRET_ACCESS_KEY=<private-storage-secret>
EMBEDDING_MODEL_PATH=/opt/models/bge-small-zh-v1.5
EMBEDDING_MODEL_LOCAL_ONLY=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Provider keys are intentionally absent. Users add their own credentials
# through the BYOK Provider flow after authentication.
