# Local development only. Never commit config/.env.
APP_ENV=development
# Use exact origins in production, for example https://gateway.example.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
PROVIDER_TEST_RATE_LIMIT_PER_MINUTE=5
WORKSPACE_REQUEST_RATE_LIMIT_PER_MINUTE=60
WORKSPACE_MAX_CONCURRENT_REQUESTS=8
GLOBAL_MAX_CONCURRENT_REQUESTS=32
APP_NAME=AI Semantic Cache Gateway
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000

# Optional PostgreSQL backend. Leave empty to keep local SQLite.
# The schema must be initialized with the Stage 2 migration tool first.
DATABASE_URL=
APP_ENV=development
BYOK_ENABLED=false
ALLOW_GLOBAL_PROVIDER_FALLBACK=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_RETRIES=0

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_THRESHOLD=0.75
CACHE_INDEX_NAME=cache_idx
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_LOCAL_ONLY=false
EMBEDDING_CACHE_DIR=

AUTH_FRONTEND_URL=http://127.0.0.1:8000
AUTH_SECRET_KEY=replace-with-a-local-only-random-secret
# OAuth client credentials are configured only when testing OAuth locally.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADMIN_USER_ID=
ADMIN_EMAIL=admin@example.com

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
QWEN_CLASSIFIER_API_KEY=
QWEN_CLASSIFIER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLASSIFIER_MODEL=qwen3.6-flash-2026-04-16
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-3.0

# Generated image persistence. Keep local for development; use a private
# S3-compatible bucket in production.
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_PATH=data/media
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PER_WORKSPACE=1000
IMAGE_MAX_WORKSPACE_BYTES=1073741824
IMAGE_FETCH_TIMEOUT=30
IMAGE_UPLOAD_RETRIES=2
IMAGE_PRESIGN_TTL=300
IMAGE_SOURCE_ALLOWLIST=aliyuncs.com,aliyun.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
